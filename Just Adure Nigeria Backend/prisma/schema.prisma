generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  admin
  super_admin
}

enum UserStatus {
  active
  suspended
  disabled
}

enum TokenType {
  email_verification
  password_reset
}

enum ProductAvailability {
  in_stock
  low_stock
  out_of_stock
  archived
}

enum InventoryMovementType {
  reservation
  release
  sale
  restock
  adjustment
}

enum OrderStatus {
  pending_payment
  paid
  processing
  ready_for_delivery
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  successful
  failed
  refunded
}

enum CouponDiscountType {
  fixed
  percentage
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum SubscriptionStatus {
  subscribed
  unsubscribed
}

enum ContactMessageStatus {
  new
  in_progress
  resolved
  spam
}

enum EmailStatus {
  pending
  sent
  delivered
  failed
}

enum PaymentEventStatus {
  received
  processed
  ignored
  failed
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  role               UserRole             @default(customer)
  status             UserStatus           @default(active)
  emailVerifiedAt    DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  addresses          Address[]
  adminActivities    AdminActivityLog[]   @relation("AdminActor")
  carts              Cart[]
  inventoryMovements InventoryMovement[]  @relation("InventoryActor")
  orders             Order[]
  orderStatusChanges OrderStatusHistory[] @relation("OrderStatusActor")
  refreshSessions    RefreshSession[]
  reviews            Review[]
  verificationTokens VerificationToken[]
  wishlist           Wishlist?

  @@index([role, status])
}

model RefreshSession {
  id              String          @id @default(cuid())
  tokenHash       String          @unique
  familyId        String
  userId          String
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedById    String?         @unique
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime        @default(now())
  lastUsedAt      DateTime?
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy      RefreshSession? @relation("SessionRotation", fields: [replacedById], references: [id])
  replacedSession RefreshSession? @relation("SessionRotation")

  @@index([userId, expiresAt])
  @@index([familyId])
}

model VerificationToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  type       TokenType
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
}

model Address {
  id                   String   @id @default(cuid())
  userId               String
  recipientName        String
  phone                String
  line1                String
  line2                String?
  landmark             String?
  city                 String
  state                String
  postalCode           String?
  deliveryInstructions String?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  logoUrl     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Category {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String?
  imageUrl       String?
  seoTitle       String?
  seoDescription String?
  isActive       Boolean          @default(true)
  parentId       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  parent         Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]       @relation("CategoryTree")
  couponLinks    CouponCategory[]
  products       Product[]

  @@unique([parentId, name])
  @@index([parentId, isActive])
}

model ConditionGrade {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id                  String                 @id @default(cuid())
  name                String
  slug                String                 @unique
  sku                 String                 @unique
  brandId             String
  categoryId          String
  conditionGradeId    String
  priceKobo           Int
  previousPriceKobo   Int?
  stockQuantity       Int                    @default(0)
  reservedQuantity    Int                    @default(0)
  lowStockThreshold   Int                    @default(1)
  shortDescription    String
  description         String
  visibleDefects      String?
  includedAccessories String?
  warrantyInformation String?
  colour              String?
  modelNumber         String?
  availability        ProductAvailability    @default(in_stock)
  isFeatured          Boolean                @default(false)
  isArchived          Boolean                @default(false)
  seoTitle            String?
  seoDescription      String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  brand               Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category            Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  conditionGrade      ConditionGrade         @relation(fields: [conditionGradeId], references: [id], onDelete: Restrict)
  cartItems           CartItem[]
  couponLinks         CouponProduct[]
  images              ProductImage[]
  inventoryMovements  InventoryMovement[]
  orderItems          OrderItem[]
  reviews             Review[]
  specifications      ProductSpecification[]
  wishlistItems       WishlistItem[]

  @@index([categoryId, availability, isArchived])
  @@index([brandId, availability])
  @@index([isFeatured, createdAt])
  @@index([priceKobo])
}

model ProductImage {
  id                 String   @id @default(cuid())
  productId          String
  cloudinaryPublicId String
  secureUrl          String
  width              Int?
  height             Int?
  altText            String
  sortOrder          Int
  isPrimary          Boolean  @default(false)
  createdAt          DateTime @default(now())
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@unique([cloudinaryPublicId])
  @@index([productId, isPrimary])
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  groupName String?
  label     String
  value     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
  @@index([productId, sortOrder])
}

model InventoryMovement {
  id                        String                @id @default(cuid())
  productId                 String
  orderId                   String?
  actorId                   String?
  type                      InventoryMovementType
  stockDelta                Int                   @default(0)
  reservedDelta             Int                   @default(0)
  resultingStockQuantity    Int
  resultingReservedQuantity Int
  reason                    String
  createdAt                 DateTime              @default(now())
  product                   Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  order                     Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor                     User?                 @relation("InventoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId])
}

model Cart {
  id                 String     @id @default(cuid())
  userId             String?
  anonymousSessionId String?    @unique
  currency           String     @default("NGN")
  expiresAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  user               User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              CartItem[]

  @@unique([userId])
  @@index([expiresAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model Order {
  id                      String               @id @default(cuid())
  orderNumber             String               @unique
  userId                  String?
  guestEmail              String?
  guestPhone              String?
  guestAccessTokenHash    String?              @unique
  status                  OrderStatus          @default(pending_payment)
  currency                String               @default("NGN")
  subtotalKobo            Int
  discountKobo            Int                  @default(0)
  deliveryFeeKobo         Int
  totalKobo               Int
  couponId                String?
  couponSnapshot          Json?
  deliveryAddressSnapshot Json
  deliveryZoneId          String?
  deliveryZoneSnapshot    Json
  customerNote            String?
  reservationExpiresAt    DateTime?
  paidAt                  DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  user                    User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon                  Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  deliveryZone            DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  couponUsages            CouponUsage[]
  emailLogs               EmailLog[]
  inventoryMovements      InventoryMovement[]
  items                   OrderItem[]
  payments                Payment[]
  statusHistory           OrderStatusHistory[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([reservationExpiresAt, status])
}

model OrderItem {
  id                     String   @id @default(cuid())
  orderId                String
  productId              String?
  productName            String
  productSlug            String
  sku                    String
  imageUrl               String?
  conditionGradeCode     String
  conditionGradeName     String
  visibleDefects         String?
  modelNumber            String?
  specificationsSnapshot Json?
  unitPriceKobo          Int
  previousPriceKobo      Int?
  discountKobo           Int      @default(0)
  quantity               Int
  lineTotalKobo          Int
  createdAt              DateTime @default(now())
  order                  Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  review                 Review?

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  actorId   String?
  source    String
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor     User?       @relation("OrderStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Payment {
  id                   String         @id @default(cuid())
  orderId              String
  provider             String         @default("paystack")
  providerReference    String         @unique
  amountKobo           Int
  currency             String         @default("NGN")
  status               PaymentStatus  @default(pending)
  channel              String?
  gatewayResponse      String?
  authorizationDetails Json?
  paidAt               DateTime?
  failureReason        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events               PaymentEvent[]

  @@index([orderId, status])
  @@index([status, createdAt])
}

model PaymentEvent {
  id                String             @id @default(cuid())
  eventKey          String             @unique
  paymentId         String?
  providerReference String
  eventType         String
  payloadHash       String
  status            PaymentEventStatus @default(received)
  attempts          Int                @default(0)
  processedAt       DateTime?
  failureDetails    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  payment           Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([providerReference])
  @@index([status, createdAt])
}

model Coupon {
  id                    String             @id @default(cuid())
  code                  String             @unique
  description           String?
  discountType          CouponDiscountType
  value                 Int
  maximumDiscountKobo   Int?
  minimumSpendKobo      Int?
  startsAt              DateTime?
  endsAt                DateTime?
  totalUsageLimit       Int?
  perCustomerUsageLimit Int?
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  categoryLinks         CouponCategory[]
  orders                Order[]
  productLinks          CouponProduct[]
  usages                CouponUsage[]

  @@index([isActive, startsAt, endsAt])
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

model CouponCategory {
  couponId   String
  categoryId String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
}

model CouponUsage {
  id           String    @id @default(cuid())
  couponId     String
  orderId      String
  userId       String?
  guestEmail   String?
  discountKobo Int
  finalizedAt  DateTime?
  createdAt    DateTime  @default(now())
  coupon       Coupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, userId, finalizedAt])
  @@index([couponId, guestEmail, finalizedAt])
}

model DeliveryZone {
  id              String   @id @default(cuid())
  name            String
  state           String
  cityPattern     String?
  feeKobo         Int
  minDeliveryDays Int
  maxDeliveryDays Int
  priority        Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]

  @@index([state, isActive, priority])
}

model Review {
  id          String       @id @default(cuid())
  userId      String
  productId   String
  orderItemId String       @unique
  rating      Int
  title       String?
  body        String
  status      ReviewStatus @default(pending)
  moderatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([productId, status, createdAt])
}

model NewsletterSubscriber {
  id                   String             @id @default(cuid())
  email                String             @unique
  status               SubscriptionStatus @default(subscribed)
  consentedAt          DateTime           @default(now())
  source               String?
  unsubscribeTokenHash String             @unique
  unsubscribedAt       DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model ContactMessage {
  id                    String               @id @default(cuid())
  name                  String
  email                 String
  phone                 String?
  subject               String
  message               String
  status                ContactMessageStatus @default(new)
  assignedTo            String?
  acknowledgementSentAt DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status, createdAt])
}

model EmailLog {
  id                String      @id @default(cuid())
  providerMessageId String?     @unique
  templateType      String
  recipient         String
  userId            String?
  orderId           String?
  status            EmailStatus @default(pending)
  attempts          Int         @default(0)
  errorSummary      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  order             Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([recipient, createdAt])
  @@index([orderId, templateType])
}

model AdminActivityLog {
  id            String   @id @default(cuid())
  actorId       String?
  action        String
  entityType    String
  entityId      String?
  beforeSummary Json?
  afterSummary  Json?
  ipAddress     String?
  userAgent     String?
  requestId     String?
  createdAt     DateTime @default(now())
  actor         User?    @relation("AdminActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model HomepageBanner {
  id                 String    @id @default(cuid())
  headline           String
  supportingText     String?
  imageUrl           String
  cloudinaryPublicId String?
  destinationUrl     String?
  sortOrder          Int       @default(0)
  startsAt           DateTime?
  endsAt             DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([isActive, sortOrder])
}
